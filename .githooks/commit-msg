#!/usr/bin/env bash
# Enforce Conventional Commits (https://www.conventionalcommits.org). The release
# workflow (.github/workflows/release.yml) parses these on push to derive the next
# version, so malformed subjects would break automatic versioning:
#   fix: / perf:    -> patch      feat:          -> minor
#   feat!: / BREAKING CHANGE footer -> major      (chore/docs/ci/... -> no release)
#
# Enable once per clone:  git config core.hooksPath .githooks

msg_file="$1"
# Subject = first line that isn't blank or a comment.
subject="$(grep -vE '^[[:space:]]*(#|$)' "$msg_file" | head -n1 || true)"

# Let git's own housekeeping commits through untouched.
case "$subject" in
	"Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

# <type>[(scope)][!]: <description>
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/ -]+\))?!?: .+'
if printf '%s' "$subject" | grep -qE "$pattern"; then
	exit 0
fi

cat >&2 <<EOF
✗ Commit message is not a Conventional Commit.

    <type>[(scope)][!]: <description>

  types:    feat fix docs style refactor perf test build ci chore revert
  examples: feat(ui): add menu-bar item
            fix: correct icon corner rounding
            feat!: drop macOS 12 support        (! or a BREAKING CHANGE footer = major)

  your subject was:
    ${subject:-<empty>}
EOF
exit 1
